#!/bin/sh /etc/rc.common
# procd init script for the Soty LAN relay (dtm_relay).
# Configure /etc/config/dtm_relay, then: /etc/init.d/dtm_relay enable && start

USE_PROCD=1
START=95
STOP=15

# A router usually gets its address by DHCP, so a hard-coded announce URL
# would go stale. Prefer br-lan, then the source address of the default
# route, then the UCI LAN address; the last resort is loopback.
detect_lan_ip() {
	local ip
	ip=$(ip -4 -o addr show br-lan 2>/dev/null | \
		awk '{print $4}' | cut -d/ -f1 | head -n1)
	[ -n "$ip" ] || ip=$(ip -4 route get 192.0.2.1 2>/dev/null | \
		awk '{for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit }}')
	[ -n "$ip" ] || ip=$(uci -q get network.lan.ipaddr)
	[ -n "$ip" ] || ip=127.0.0.1
	echo "$ip"
}

start_service() {
	config_load dtm_relay

	local enabled port announce identity retention maxconn storage path
	local federation seeds
	config_get_bool enabled relay enabled 1
	[ "$enabled" = 1 ] || return 0

	config_get port relay port 3100
	config_get announce relay announce ""
	config_get identity relay identity "/etc/dtm-relay/identity"
	config_get retention relay retention_days 30
	config_get maxconn relay max_connections 128
	config_get storage relay storage "memory"
	config_get path relay path "/tmp/dtm-relay"
	config_get_bool federation relay federation 0
	config_get seeds relay seeds ""

	[ -n "$announce" ] || announce="ws://$(detect_lan_ip):$port/ws"

	set -- /usr/bin/dtm_relay \
		--listen 0.0.0.0 \
		--port "$port" \
		--announce "$announce" \
		--identity "$identity" \
		--retention-days "$retention" \
		--max-connections "$maxconn" \
		--storage "$storage"
	[ "$storage" = "disk" ] && set -- "$@" --path "$path"
	if [ "$federation" = 1 ]; then
		set -- "$@" --federation
		for seed in $seeds; do
			set -- "$@" --seed "$seed"
		done
	fi

	procd_open_instance dtm_relay
	procd_set_param command "$@"
	procd_set_param respawn 3600 5 0
	procd_set_param limits nofile="1024 1024"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger dtm_relay
}
