msgstr "Service"

msgid "State"
msgstr "État"

msgid "Running"
msgstr "En cours"

msgid "Stopped"
msgstr "Arrêté"

msgid "Autostart"
msgstr "Démarrage automatique"

msgid "Enabled"
msgstr "Activé"

