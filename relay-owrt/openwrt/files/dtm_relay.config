# Soty LAN relay (dtm_relay). UCI options map 1:1 to the binary flags.
config relay 'relay'
	# Serve the LAN. Disable to keep the package installed but idle.
	option enabled '1'

	# Plain ws:// on the LAN. allowInsecureRelay is true in the app by
	# default, so a router needs no TLS. Do not forward this port from the
	# internet: a public relay must run behind wss:// (nginx) instead.
	option port '3100'
	option announce ''

	# Ed25519 identity. NEVER delete: clients pin this public key and will
	# report IDENTITY CHANGED if it changes.
	option identity '/etc/dtm-relay/identity'

	option retention_days '30'
	option max_connections '128'

	# memory: queue is lost on reboot, no flash wear (recommended).
	# disk:   append-only journal in `path`, e.g. a USB mount.
	option storage 'memory'
	option path '/tmp/dtm-relay'

	# Federation with internet relays is optional and OFF by default.
	# Enable only with seed URLs; space-separated, each `url` or `url|pk`
	# where pk pins the remote Ed25519 identity.
	option federation '0'
	option seeds ''
